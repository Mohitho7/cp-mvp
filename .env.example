# Copy to a local `.env` file (NEVER commit real values) or export these
# variables in your shell / hosting provider. On Replit they are injected
# automatically (Replit PostgreSQL provides DATABASE_URL; everything else
# comes from Replit Secrets). Locally and on other hosts, set them here.
#
# Database: any standard PostgreSQL connection string works (Replit
# PostgreSQL, Neon, local Postgres, ...). For hosted providers that require
# TLS (e.g. Neon), append `?sslmode=require` to the URL. No code changes
# are needed to switch providers: only this variable changes.

# Server (required)
DATABASE_URL=
PORT=5000
OPENAI_API_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CAREER_INSTITUTION_NAME=
CAREER_INSTITUTION_ADMIN_EMAIL=

# AI provider selection (optional; defaults to OpenAI behavior)
# One of: openai | gemini | groq
AI_PROVIDER=openai
# Only the key for the selected provider is required.
# OPENAI_MODEL defaults to gpt-5-mini when unset.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# Frontend (Vite; required to run the web app)
VITE_CLERK_PUBLISHABLE_KEY=
# Frontend (optional)
VITE_CLERK_PROXY_URL=

# Local dev conveniences (optional)
# BASE_PATH=/            # sub-path the web app is served from
# VITE_PORT=5173         # Vite dev server port (defaults to PORT); the API
#                        # server always uses PORT, so set VITE_PORT to run
#                        # both locally.
# VITE_API_PROXY_TARGET=http://localhost:5000
#                        # where the Vite dev server proxies /api/* requests
#                        # (defaults to http://localhost:<PORT>).
# LOG_LEVEL=info
# CAREER_DEMO_SEED=true  # enable `pnpm --filter @workspace/scripts run seed:demo`
